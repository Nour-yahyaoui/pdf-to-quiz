# Copy to .env.local and fill with real values. Never commit .env.local.
# Public values are safe in the browser bundle; the other two are server-only.

# Supabase — Project URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase — anon key (public, RLS still enforces every row)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — service role key (SERVER ONLY. This app intentionally never uses it:
# all data access goes through the cookie-authenticated RLS client.)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq — server only, exposed via /api/generate-quiz
GROQ_API_KEY=gsk_replace_me
